ARG NODE_VERSION=18.20.8-alpine

FROM node:${NODE_VERSION} AS dev

ENV NG_CLI_ANALYTICS=false

WORKDIR /repo/apps/backoffices/backoffice-angular16

COPY tools/mock-api/contract /repo/tools/mock-api/contract
COPY apps/microfrontends/insights/contract /repo/apps/microfrontends/insights/contract
COPY apps/microfrontends/notes/contract /repo/apps/microfrontends/notes/contract
COPY apps/microfrontends/orders/contract /repo/apps/microfrontends/orders/contract
COPY apps/backoffices/backoffice-angular16/package.json apps/backoffices/backoffice-angular16/package-lock.json ./

RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts

COPY apps/backoffices/backoffice-angular16 ./

EXPOSE 4500

HEALTHCHECK --interval=5s --timeout=3s --start-period=60s --retries=10 \
  CMD wget -qO- http://127.0.0.1:4500/ > /dev/null || exit 1

CMD ["npm", "run", "start:docker"]
