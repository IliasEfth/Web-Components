# Dependencies
node_modules/

# Build output (every app builds its own)
dist/
dist-*/
build/
out/
*.tsbuildinfo

# Framework caches
.angular/
.vite/
.cache/
.eslintcache

# Tests and coverage
coverage/
playwright-report/
test-results/
