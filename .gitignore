# Mock API working data (recreated from db.seed.json on npm start)
tools/mock-api/db.json

# Local environment overrides (the committed .env files hold only localhost URLs)
.env.local
.env.*.local

# Logs
npm-debug.log*
*.log

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# Claude Code personal settings (shared commands in .claude/commands are committed)
.claude/settings.local.json
